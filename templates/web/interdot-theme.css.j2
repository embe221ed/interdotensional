{#- The 16-role leaf vocabulary that every theme carries, in leaf's own order:
    surfaces, then the text ladder, then accents. One list, emitted per block. -#}
{%- set ROLES = [
      "bg", "bg_deep", "panel", "border", "faint",
      "fg", "fg_strong", "muted", "dim",
      "accent", "accent2", "success", "info", "special", "warning", "danger",
    ]
-%}
{%- macro roles(t, indent="  ") -%}
{%- set c = t.tools.leaf.colors -%}
{#- Screen contrast is stricter than the terminal's: WCAG AA wants 4.5:1 for
    body text, which light-polarity accents miss on a light page. An optional
    per-role tools.web.text_darken map (HLS lightness points) derives readable
    variants, falling back to leaf's gentler tools.leaf.text_darken so a theme
    not yet tuned for the web still gets something. A missing map or a missing
    key means 0 = no-op, which is what every dark theme wants. -#}
{%- set web = t.tools.web | default({}) -%}
{%- set td = web.text_darken | default(t.tools.leaf.text_darken | default({})) -%}
{%- for role in ROLES %}
{{ indent }}--id-{{ role | replace('_', '-') }}: {{ c[role] | darken(td[role] | default(0)) }};
{%- endfor %}
{#- Pane chrome, taken from tools.tmux.colors rather than leaf's vocabulary,
    because a site laid out as tmux splits needs the SAME active/inactive
    distinction the author's pane-border-style draws. Every theme defines both.
    The active colour doubles as pane-title text, so it honours a `pane_active`
    text_darken key; the inactive one only ever draws a 1px line, where 3:1 is
    the bar, so it stays raw. -#}
{%- set tm = t.tools.tmux.colors %}
{{ indent }}--id-pane-active: {{ tm.pink | darken(td["pane_active"] | default(0)) }};
{{ indent }}--id-pane-border: {{ tm.dim }};
{%- endmacro -%}
/*******************************************************************************
 * THIS FILE WAS AUTO-GENERATED BY INTERDOTENSIONAL.
 * DO NOT EDIT THIS FILE MANUALLY.
 * Any manual changes will be overwritten during the next generation.
 * Please update the source YAML configuration and templates instead.
 *
 * Website theme: {{ theme.name }}
{%- if pair %}, paired with {{ pair.name }}{% endif %}
 *
 * Custom properties only - no component styling, no resets, no selectors of
 * your own. Consume the roles as var(--id-fg), var(--id-accent), and so on.
 *
 * Unlike every other target a website ships to visitors who cannot run
 * interdot, so BOTH polarities are emitted here and switched in the browser:
 * the OS preference by default, overridden by a data-theme attribute on <html>.
 ******************************************************************************/

/* The active theme is the default, so a visitor with no stored preference and
   no OS signal sees exactly what interdot last generated. */
:root {
  color-scheme: {{ "light dark" if pair else theme.polarity }};
  {{- roles(theme) }}

  /* Inert provenance: readable from JS or devtools, consumed by no rule. */
  --id-author-theme: "{{ theme.name }}";
  --id-author-font: "{{ font.family }}";
}
{%- if pair %}
{%- set light = theme if theme.polarity == "light" else pair %}
{%- set dark = theme if theme.polarity == "dark" else pair %}

/* The counterpart polarity, for visitors whose OS asks for it. Scoped to
   :not([data-theme]) so it applies only while the visitor has expressed no
   preference of their own. */
@media (prefers-color-scheme: {{ pair.polarity }}) {
  :root:not([data-theme]) {
    {{- roles(pair, "    ") }}
  }
}

/* Manual override. Both polarities are spelled out unconditionally so that a
   data-theme attribute beats prefers-color-scheme in BOTH directions: a dark
   OS plus data-theme="light" must land on light, and the reverse. */
:root[data-theme="light"] {
  {{- roles(light) }}
}

:root[data-theme="dark"] {
  {{- roles(dark) }}
}
{%- endif %}

