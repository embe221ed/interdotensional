set -g mouse on
{% set tmux_theme = theme.tools.tmux %}

set-option -g clock-mode-colour colour{{ tmux_theme.clock }}

set-option -g menu-selected-style "fg={{ tmux_theme.colors.selected.fg }},bg={{ tmux_theme.colors.selected.bg }},bold"
set-option -g mode-style "fg={{ tmux_theme.colors.selected.fg }},bg={{ tmux_theme.colors.selected.bg }},bold"
set-option -g message-style "fg={{ tmux_theme.colors.selected.fg }},bg={{ tmux_theme.colors.selected.bg }},fill={{ tmux_theme.colors.selected.bg }}"
set-option -g prompt-cursor-colour "{{ tmux_theme.colors.pink }}"

set-option -g pane-active-border-style "fg={{ tmux_theme.colors.pink }}"
set-option -g pane-border-lines {{ tmux.pane.border.lines }}
set-option -g pane-border-style "fg={{ tmux_theme.colors.dim }}"
set-option -g pane-border-format "#{?pane_active,#[fg={{ tmux_theme.colors.pink }}],#[fg={{ tmux_theme.colors.dim }}]}{{ tmux.pane.border.format }}"
set-option -g pane-border-status {{ tmux.pane.border.status }}
set-option -g pane-border-indicators {{ tmux.pane.border.indicators }}

# jump-to-pane overlay (prefix + q), themed
set-option -g display-panes-colour "{{ tmux_theme.colors.dim }}"
set-option -g display-panes-active-colour "{{ tmux_theme.colors.pink }}"
set-option -g display-panes-time 2000

set-option -g popup-border-style "fg={{ tmux_theme.colors.pink }},{{ tmux.popup.border.style }}"
{% if ui.border == "none" %}
set-option -g popup-border-lines "padded"
set-option -g popup-border-style "bg={{ tmux_theme.colors.selected.bg }}"
set-option -g popup-style "bg={{ tmux_theme.colors.selected.bg }}"
{% else %}
set-option -g popup-border-lines {{ ui.border }}
{% endif %}

set-window-option -g mode-keys vi
set-option -sg escape-time 0
set-option -g default-terminal "$TERM"
set-option -ga terminal-overrides ",*:RGB"
set-option -g renumber-windows on   # keep numbering sequential

# window / pane numbering starts at 1 (pairs with renumber-windows)
set-option -g base-index 1
set-window-option -g pane-base-index 1

# roomier scrollback, readable messages
set-option -g history-limit {{ tmux.history_limit }}
set-option -g display-time {{ tmux.display_time }}

# stay in tmux after the last session is killed; size windows to the smallest client actually viewing them
set-option -g detach-on-destroy off
set-window-option -g aggressive-resize on

# terminal capabilities for nvim in kitty/ghostty:
# distinct modified keys (C-i vs Tab, C-6, S-Enter), OSC-52 clipboard, graphics passthrough, undercurl, hyperlinks
set-option -s extended-keys on
set-option -as terminal-features ",*:extkeys"
set-option -g set-clipboard on
set-option -as terminal-features ",*:clipboard"
set-option -g allow-passthrough on
set-option -as terminal-features ",*:usstyle"
set-option -as terminal-features ",*:hyperlinks"

# unbind keys
unbind-key Up
unbind-key Down
unbind-key Left
unbind-key Right
unbind-key '"'
unbind-key %
unbind-key w

# Splitting terminals using | and -
bind-key - split-window -v -c '#{pane_current_path}'
bind-key | split-window -h -c '#{pane_current_path}'

# vim-like pane switching (single-shot: no repeat, so the next keystroke isn't swallowed)
bind-key k select-pane -U
bind-key j select-pane -D
bind-key h select-pane -L
bind-key l select-pane -R

# vim-like pane resizing (repeatable — hold the chord)
set-option -g repeat-time 700
bind-key -r C-k resize-pane -U 2
bind-key -r C-j resize-pane -D 2
bind-key -r C-h resize-pane -L 2
bind-key -r C-l resize-pane -R 2

# updated choose-tree windows formatting
bind-key w choose-tree -ZwF "[#{window_name} @ #{s|#(echo $USER)|~|:#{b:pane_current_path}}]"

# copy-mode (vi): whole-token word motions, vim v/y selection, themed search + line numbers
set-option -g word-separators " "
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
set-option -g copy-mode-match-style "fg={{ tmux_theme.colors.selected.bg }},bg={{ tmux_theme.colors.yellow }}"
set-option -g copy-mode-current-match-style "fg={{ tmux_theme.colors.selected.bg }},bg={{ tmux_theme.colors.pink }},bold"
set-option -g copy-mode-line-numbers hybrid
set-option -g copy-mode-line-number-style "fg={{ tmux_theme.colors.dim }}"
set-option -g copy-mode-current-line-number-style "fg={{ tmux_theme.colors.pink }},bold"

# status line
set-option -g status on
set-option -g status-interval 2
set-option -g status-style "bg=default,fg={{ tmux_theme.colors.dim }}"
set-option -g status-left " "
set-option -g status-right "#{?client_prefix,#[fg=yellow]● ,}#{?pane_in_mode,#[fg={{ tmux_theme.colors.pink }}]▲ ,}#{?pane_synchronized,#[fg=red]⇋ ,}#[fg=default]#S "

# status (windows)
set -g window-status-format "● "
set -g window-status-current-format "● "
set -g window-status-current-style "#{?window_zoomed_flag,fg=yellow,fg={{ tmux_theme.colors.pink }}}"
set -g window-status-bell-style "fg=red,nobold"

# popup!
bind-key -n M-p if-shell -F '#{==:#{session_name},scratch}' {
  detach-client
} {
  display-popup -w70% -h70% -E "tmux new-session -A -s scratch -c ~"
}

# floating pane (prefix + *): non-modal, themed borders, opens in the current path
bind-key * new-pane -c '#{pane_current_path}' -S "fg={{ tmux_theme.colors.pink }}" -R "fg={{ tmux_theme.colors.dim }}"

# === tmux-fzf-links ===
set-option -g @fzf-links-key C-p
# set-option -g @fzf-links-history-lines "0"
set-option -g @fzf-links-editor-open-cmd "tmux new-window -n 'nvim' /usr/local/bin/nvim +%line '%file'"
set-option -g @fzf-links-browser-open-cmd "open '%url'"
# set-option -g @fzf-links-fzf-path "fzf"
set-option -g @fzf-links-fzf-display-options "-w 50% --maxnum-displayed 30 --multi --track --no-preview"
# set-option -g @fzf-links-path-extension "/usr/local/bin"
# set-option -g @fzf-links-loglevel-tmux "WARNING"
# set-option -g @fzf-links-loglevel-file "DEBUG"
# set-option -g @fzf-links-log-filename "~/log.txt"
set-option -g @fzf-links-python "$HOME/.pyenv/shims/python3"
# set-option -g @fzf-links-python-path "~/.virtualenvs/my_special_venv/lib/python3.11/site-packages"
# set-option -g @fzf-links-user-schemes-path "~/.tmux/plugins/tmux-fzf-links/user_schemes/user_schemes.py"
set-option -g @fzf-links-use-colors on
# set-option -g @fzf-links-ls-colors-filename "~/.cache/tmux-fzf-links/cached_ls_colors.txt"
set-option -g @fzf-links-hide-bottom-bar off

# === interdimux ===
{% if theme.tools.interdimux is defined and theme.tools.interdimux %}
{% for key, value in theme.tools.interdimux.items() %}
set-option -g @interdimux-color-{{ key | replace('_', '-') }} "{{ value }}"
{%- endfor %}
{% endif %}

# === tmux-fuzzback (fuzzy scrollback search) ===
set-option -g @fuzzback-bind /

# TPM
## List of plugins
set-option -g @plugin 'alberti42/tmux-fzf-links'
set-option -g @plugin 'embe221ed/interdimux'
set-option -g @plugin 'roosta/tmux-fuzzback'
set-option -g @plugin 'tmux-plugins/tpm'

## Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
