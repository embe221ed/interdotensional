#
# Universal / themeable zsh config, symlinked to $ZSH_CUSTOM/interdot.zsh and
# auto-sourced by oh-my-zsh from `for f ($ZSH_CUSTOM/*.zsh(N))` — i.e. AFTER the
# lib/*.zsh files and the plugins loop, but BEFORE the prompt theme and before
# the rest of ~/.zshrc. That slot is exactly right for overriding oh-my-zsh's
# own defaults (completion, history) and for binding to widgets the plugins
# already defined. Machine-specific bootstrap (govman/pyenv/rbenv/nvm/cargo/
# fpath) stays hand-owned in ~/.zshrc — never generated.
{% set zc = theme.tools.zsh.colors %}
# --- light/dark: interdot is the single source of truth (theme.polarity) -----
# Loaded before ~/.zshrc's alias section at startup (which reads DISPLAY_MODE to
# pick BAT_THEME and the colorls flags), and never re-sourced into a live shell:
# a theme flip is applied by starting a fresh shell (`exec zsh`), so nothing in
# here has to be idempotent.
export DISPLAY_MODE="{{ 'Light' if theme.polarity == 'light' else 'Dark' }}"

# --- syntax-highlighting: theme the comment color from the palette (CFG-4) ----
# (was a hand-hardcoded fg=#6f6f6f in ~/.zshrc that drifted across all themes)
{% if zsh.highlighter == 'fast' -%}
# Guarded: assigning into the assoc when the plugin is absent is a fatal
# "invalid subscript" that would abort the rest of this file.
(( $+FAST_HIGHLIGHT_STYLES )) && FAST_HIGHLIGHT_STYLES[comment]='fg={{ zc.comment }}'
{%- else -%}
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[comment]='fg={{ zc.comment }}'
{%- endif %}

# --- vi-mode runtime toggles (read inside plugin functions, safe post-load) ---
VI_MODE_SET_CURSOR=true
VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true

# --- reset the cursor shape on exit so the vi bar doesn't leak upward (CFG-10) --
# vi-mode's line-finish reset misses the Ctrl-D/EOF path; cover it on shell exit.
autoload -Uz add-zsh-hook
# $'…' (ANSI-C quoting) is required: `print -r` does NOT interpret escapes, so a
# plain '\e[0 q' prints the six literal characters instead of the ESC sequence.
_reset_cursor() { print -rn -- $'\e[0 q'; }
add-zsh-hook zshexit _reset_cursor

# --- globbing & bell hygiene --------------------------------------------------
setopt EXTENDED_GLOB       # ^neg  ~except  (#i)case-glob  **/  qualifiers
setopt NUMERIC_GLOB_SORT   # file2 before file10 in *  (version/log files)
# EXTENDED_GLOB makes ^ a glob operator, so `git show HEAD^` would die as an
# unmatched pattern before git ever runs. Unmatched globs now pass through
# literally (bash behaviour) instead of being a hard error.
setopt NO_NOMATCH
setopt NO_BEEP             # silence the ZLE/completion bell (rings locally over SSH)

# --- history: match SAVEHIST to HISTSIZE, tighten dedup/blanks ----------------
# oh-my-zsh floors HISTSIZE at 50000 but SAVEHIST at only 10000; lift it here.
SAVEHIST=50000
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# --- completion: let fzf-tab own selection, then group + label results --------
# oh-my-zsh sets `menu select` at a 5-wildcard context; match that specificity
# to actually turn it off so fzf-tab captures the unambiguous prefix.
zstyle ':completion:*:*:*:*:*' menu no
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '[%d]'                                  # plain: fzf-tab strips escapes here
zstyle ':completion:*:warnings'     format '%F{{ '{' }}{{ zc.red }}{{ '}' }}no matches%f'
zstyle ':completion:*:messages'     format '%F{{ '{' }}{{ zc.blue }}{{ '}' }}%d%f'
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' show-group brief

# --- keybindings --------------------------------------------------------------
# Esc is a prefix of many viins bindings (^[[A, ^[OA, ^[f, …), so ZLE waits
# KEYTIMEOUT tenths of a second before it can conclude the byte was a lone Esc.
# At the default 40 the cursor shape and mode indicator lag ~400 ms behind Esc.
KEYTIMEOUT=10

bindkey '^k' autosuggest-accept   # accept the whole autosuggestion
bindkey '^l' forward-word         # step over one word (Ctrl-Right also does this)

# edit the current command line in $EDITOR — vicmd v (R3)
autoload -Uz edit-command-line
zle -N edit-command-line
# vi-mode binds `vv` to the same widget. Leaving it makes `v` a PREFIX of a
# longer binding, so ZLE stalls for KEYTIMEOUT before dispatching the one-key
# form. Note this also replaces vicmd `v` = visual-mode.
bindkey -M vicmd -r 'vv'
bindkey -M vicmd 'v' edit-command-line

# substring history search (plugin: history-substring-search), guarded so the
# fragment is harmless if the plugin is ever absent.
if (( ${+widgets[history-substring-search-up]} )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  [[ -n ${terminfo[kcuu1]} ]] && bindkey "${terminfo[kcuu1]}" history-substring-search-up
  [[ -n ${terminfo[kcud1]} ]] && bindkey "${terminfo[kcud1]}" history-substring-search-down
  bindkey -M vicmd 'k' history-substring-search-up
  bindkey -M vicmd 'j' history-substring-search-down
fi
